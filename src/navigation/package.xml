<?xml version="1.0"?>
<package format="3">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>Online terrain-aware MINCO planning, MPC path interfaces, and real-robot navigation bringup.</description>
  <maintainer email="li15933001767@163.com">Li-Anjing</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>backward_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>rcl_interfaces</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>
  <depend>rog_map</depend>
  <depend>eigen</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <depend>rclcpp_components</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
